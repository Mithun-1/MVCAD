{
  "appId": "com.mithun.mvcad",
  "productName": "MVCAD",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": ["dist/**/*", "desktop/**/*", "build/icon.png", "package.json"],
  "asar": true,
  "npmRebuild": false,
  "artifactName": "MVCAD-${version}-${os}-${arch}.${ext}",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "MVCAD.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ],
    "category": "public.app-category.graphics-design",
    "icon": "build/icon.png",
    "hardenedRuntime": true,
    "artifactName": "MVCAD-arm64.${ext}",
    "identity": "-",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  },
  "publish": {
    "provider": "github",
    "owner": "Mithun-1",
    "repo": "MVCAD",
    "releaseType": "release"
  },
  "extraResources": [
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    }
  ]
}
