{
  "appId": "com.mithun.mvcad",
  "productName": "MVCAD",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": ["dist/**/*", "desktop/**/*", "build/icon.png", "package.json"],
  "asar": true,
  "npmRebuild": false,
  "artifactName": "MVCAD-${version}-${os}-${arch}.${ext}",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico",
    "artifactName": "MVCAD.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "github",
    "owner": "Mithun-1",
    "repo": "MVCAD",
    "releaseType": "release"
  },
  "extraResources": [
    {
      "from": "THIRD_PARTY_NOTICES.md",
      "to": "THIRD_PARTY_NOTICES.md"
    }
  ]
}
